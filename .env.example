# AlgoVerse Code Execution Service Configuration
# Provider options: 'piston' (default) or 'judge0'
CODE_EXECUTION_PROVIDER=piston

# Remote Sandboxed Execution Service URL
# Example for Piston public API: https://emkc.org/api/v2/piston
# Example for self-hosted Judge0: http://localhost:2358 or RapidAPI endpoint
CODE_EXECUTION_URL=https://emkc.org/api/v2/piston

# Optional API key for RapidAPI / authenticated Judge0 instance
CODE_EXECUTION_API_KEY=

# Backend API Server Port
PORT=3001
